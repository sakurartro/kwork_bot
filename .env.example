# --- Telegram ---
# токен из @BotFather
TELEGRAM_BOT_TOKEN=
# ваш Telegram user id (бот работает только для вас)
TELEGRAM_OWNER_ID=

# --- Gemini ---
# ключ получить на https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Anti-block ---
PARSE_DELAY_MIN=90
PARSE_DELAY_MAX=150
# список прокси через запятую (опц.)
PROXY_LIST=

# --- Локальный тестовый веб-сервер парсера ---
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Storage / logs ---
DB_PATH=data/kwork_bot.db
LOG_LEVEL=INFO
